{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "es2022",
        "lib": [
            "es2022",
            "dom"
        ],
        "allowSyntheticDefaultImports": true
    },
    "exclude": [
        "node_modules",
        ".vscode-test"
    ],
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "notebook/**/*.ts",
        "notebook/**/*.d.ts"
    ]
}